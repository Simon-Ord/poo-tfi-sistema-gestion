<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.unpsjb.poo.controller.ProveedoresVistaControlador"
            style="-fx-background-color: linear-gradient(to bottom right, #1c1f2b, #242a3a);">

    <top>
        <Label text="Gestión de Proveedores" style="-fx-font-size: 24px; -fx-text-fill: white; -fx-padding: 20;" />
    </top>

    <center>
        <TableView fx:id="tablaProveedores" prefWidth="700" prefHeight="400">
            <columns>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="200" />
                <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="150" />
                <TableColumn fx:id="colEmail" text="Email" prefWidth="200" />
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="10" style="-fx-padding: 10;">
            <Button text="Agregar Proveedor" onAction="#agregarProveedor" />
            <Button text="Editar" onAction="#editarProveedor" />
            <Button text="Eliminar" onAction="#eliminarProveedor" />
        </HBox>
    </bottom>
</BorderPane>
