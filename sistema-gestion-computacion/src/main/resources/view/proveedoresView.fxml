<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" stylesheets="@css/styles.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.unpsjb.poo.controller.ProveedoresVistaControlador">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20"/>
    </padding>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Proveedores" styleClass="titulo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <CheckBox fx:id="chBoxInactivos" text="Mostrar proveedores inactivos"/>
    </HBox>

    <!-- Removemos columnResizePolicy directo (causó error de carga); se aplicará desde el controlador -->
    <TableView fx:id="tablaProveedores" VBox.vgrow="ALWAYS">
        <columns>
            <!-- Ajustamos anchos relativos: Nombre reducido para que quepan todos sin overflow -->
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="160" maxWidth="180" minWidth="140"/>
            <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="110" maxWidth="130" minWidth="90"/>
            <TableColumn fx:id="colEmail" text="Email" prefWidth="180" maxWidth="220" minWidth="150"/>
            <TableColumn fx:id="colDireccion" text="Dirección" prefWidth="140" maxWidth="170" minWidth="120"/>
            <TableColumn fx:id="colTipo" text="Tipo" prefWidth="80" maxWidth="90" minWidth="70"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="70" maxWidth="80" minWidth="60"/>
        </columns>
    </TableView>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Agregar Proveedor" onAction="#agregarProveedor"/>
        <Button text="Editar Proveedor" onAction="#editarProveedor"/>
        <Button text="Activar/Desactivar" onAction="#cambiarEstadoProveedor"/>
    </HBox>

</VBox>