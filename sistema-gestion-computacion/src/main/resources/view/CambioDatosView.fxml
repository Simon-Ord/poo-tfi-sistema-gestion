<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.unpsjb.poo.controller.CambioDatosController"
      stylesheets="@css/styleCambioDatos.css"
      spacing="15"
      alignment="CENTER">

    <padding>
        <Insets top="25" right="25" bottom="30" left="25" />
    </padding>

    <Label text="Modificar tus Datos" styleClass="titulo"/>

    <GridPane hgap="10" vgap="10" alignment="CENTER">
        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" />
            <ColumnConstraints halignment="LEFT" hgrow="ALWAYS" />
        </columnConstraints>

        <!-- Contraseña actual -->
        <Label text="Contraseña actual:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <PasswordField fx:id="txtContrasenaActual" GridPane.rowIndex="0" GridPane.columnIndex="1" promptText="********" />

        <!-- Nuevo nombre -->
        <Label text="Nuevo nombre y apellido:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNuevoNombre" GridPane.rowIndex="1" GridPane.columnIndex="1" promptText="Ej: Daniel Gomez" />

        <!-- Nuevo usuario -->
        <Label text="Nuevo usuario:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNuevoUsuario" GridPane.rowIndex="2" GridPane.columnIndex="1" promptText="Ej: dgomez" />

        <!-- Nuevo email -->
        <Label text="Nuevo email:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNuevoEmail" GridPane.rowIndex="3" GridPane.columnIndex="1" promptText="Ej: daniel@gmail.com" />

        <!-- Nueva contraseña -->
        <Label text="Nueva contraseña:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <PasswordField fx:id="txtNuevaContrasena" GridPane.rowIndex="4" GridPane.columnIndex="1" promptText="********" />

        <!-- Confirmar contraseña -->
        <Label text="Confirmar contraseña:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <PasswordField fx:id="txtConfirmarContrasena" GridPane.rowIndex="5" GridPane.columnIndex="1" promptText="********" />
    </GridPane>

    <HBox alignment="CENTER" spacing="12">
        <Button text="Guardar cambios" onAction="#guardarCambios" styleClass="btn-principal"/>
        <Button text="Cancelar" onAction="#cancelar" styleClass="btn-secundario"/>
    </HBox>
</VBox>
