<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" 
            prefHeight="450.0" prefWidth="502.0" 
            styleClass="root"
            stylesheets="@css/styleFacturaCarrito.css"
            xmlns="http://javafx.com/javafx/24.0.1" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.unpsjb.poo.controller.CodigosListaControlador">
   <children>
      <VBox layoutX="10.0" layoutY="10.0" prefHeight="430.0" prefWidth="580.0" 
            styleClass="panel-info"
            AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" 
            AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
         <children>
            <!-- Título -->
            <Label text="Lista de Códigos de Productos" styleClass="titulo">
               <VBox.margin>
                  <Insets bottom="15.0" left="0.0" right="0.0" top="0.0" />
               </VBox.margin>
            </Label>
            
            <!-- Contenido principal -->
            <VBox spacing="15.0">
               <children>
                  <!-- Barra de búsqueda -->
                  <HBox alignment="CENTER_LEFT" spacing="15.0">
                     <children>
                        <Label text="Buscar:" styleClass="label-form" />
                        <TextField fx:id="txtBuscar" prefWidth="300.0" 
                                  promptText="Buscar por código, nombre o cualquier campo..." 
                                  styleClass="text-field-custom" />
                     </children>
                  </HBox>
                  
                  <!-- Tabla de productos -->
                  <TableView fx:id="productosTable" prefHeight="300.0" styleClass="table-view">
                    <columns>
                      <TableColumn fx:id="colCodigo" prefWidth="80.0" text="Código" />
                      <TableColumn fx:id="colNombre" prefWidth="334.0" text="Nombre" />
                      <TableColumn fx:id="colStock" prefWidth="60.0" text="Stock" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
                  
                  <!-- Botones -->
                  <HBox alignment="CENTER_RIGHT" spacing="12.0">
                     <children>
                        <Button fx:id="btnSeleccionar" mnemonicParsing="false" onAction="#handleSeleccionar" 
                               prefWidth="120.0" text="Seleccionar" styleClass="btn-agregar" />
                        <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#handleCancelar" 
                               prefWidth="100.0" text="Cancelar" styleClass="btn-quitar" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
